<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Trust production domains -->
    <domain-config cleartextTrafficPermitted="false">
        <!-- Supabase -->
        <domain includeSubdomains="true">supabase.co</domain>

        <!-- New production domains -->
        <domain includeSubdomains="true">peacefulmeditationapp.com</domain>
        <domain includeSubdomains="true">support.peacefulmeditationapp.com</domain>
        <domain includeSubdomains="true">app.peacefulmeditationapp.com</domain>
        <domain includeSubdomains="true">cdn.peacefulmeditationapp.com</domain>

        <!-- Legacy domains (backwards compatibility during transition) -->
        <domain includeSubdomains="true">support.peacefulkids.app</domain>
        <domain includeSubdomains="true">peacefulkids.app</domain>
    </domain-config>
</network-security-config>
