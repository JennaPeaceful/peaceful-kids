# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Sentry Configuration
# Get your DSN from: https://sentry.io/settings/[org]/projects/[project]/keys/
# Sign up for free at: https://sentry.io/signup/
VITE_SENTRY_DSN="https://your-dsn@sentry.io/project-id"
VITE_APP_VERSION="1.0.0"

# Optional: Enable Sentry in development mode
# VITE_SENTRY_DEV="true"

# PostHog Analytics Configuration
# Get your API key from: https://app.posthog.com/project/settings
# Sign up for free at: https://posthog.com/signup
VITE_POSTHOG_KEY="your-posthog-api-key"
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# Optional: Enable PostHog in development mode
# VITE_POSTHOG_DEV="true"
